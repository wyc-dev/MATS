# ─── MATS Configuration ───
# Multi-Agent Trading System
# Copy this file to .env and fill in your values.

# ═══════════════════════════════════════════════════════════════
# OLLAMA — Primary LLM provider
# ═══════════════════════════════════════════════════════════════
# Local Ollama (free, no API key) or Ollama Pro (cloud models)
# Recommended: Upgrade to Ollama Pro for cloud model access
# (deepseek-v4-flash:0731-cloud, kimi-k2.6:cloud, glm-5.2:cloud)
# — faster inference, no local GPU, supports 8-agent concurrency
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=deepseek-v4-flash:0731-cloud

# ═══════════════════════════════════════════════════════════════
# HYPERLIQUID — Wallet for real trading + WS user-level feeds
# ═══════════════════════════════════════════════════════════════
# Leave blank for paper trading mode.
# When filled, the system can:
#   - Place real orders on Hyperliquid
#   - Subscribe to clearinghouseState + userFills WS feeds
#   - Display real wallet balance/equity in the UI
HYPERLIQUID_WALLET_ADDRESS=                  # Your Arbitrum wallet address (0x...)
# v2.0.869-P13(主神 env 安全):private key 可以存喺 OS 安全儲存,而唔係明文 .env。
# !command 語法係跨平台(執行任何 shell 命令)——按平台選用:
#
#   macOS Keychain:
#     security add-generic-password -a "$USER" -s 'mats-hyperliquid-private-key' -w '0x...你的私鑰...'
#     HYPERLIQUID_PRIVATE_KEY=!security find-generic-password -a "$USER" -s 'mats-hyperliquid-private-key' -w
#
#   Windows Credential Manager(PowerShell):
#     HYPERLIQUID_PRIVATE_KEY=!powershell -NoProfile -Command "(Get-StoredCredential -Target 'mats-hyperliquid-private-key').GetNetworkCredential().Password"
#
#   Linux Secret Service(libsecret):
#     HYPERLIQUID_PRIVATE_KEY=!secret-tool lookup service mats-hyperliquid-private-key
#
#   Linux pass(password store):
#     HYPERLIQUID_PRIVATE_KEY=!pass show mats/hyperliquid-private-key
#
# 明文 fallback(唔建議——.env 必須 chmod 600):
HYPERLIQUID_PRIVATE_KEY=                     # Your private key (secp256k1, 64 hex chars)

# ═══════════════════════════════════════════════════════════════
# PAPER TRADING — Simulation parameters
# ═══════════════════════════════════════════════════════════════
PAPER_INITIAL_BALANCE=1000
PAPER_MAX_POSITION_SIZE_PCT=0.20
PAPER_MAX_DRAWDOWN_PCT=0.20
PAPER_DAILY_LOSS_LIMIT_PCT=0.05

# ═══════════════════════════════════════════════════════════════
# RISK — Position sizing, SL/TP, veto thresholds
# ═══════════════════════════════════════════════════════════════
RISK_MAX_LEVERAGE=1.0
RISK_STOP_LOSS_PCT=0.02
RISK_TAKE_PROFIT_PCT=0.05
RISK_TRAILING_STOP_PCT=0.015
RISK_VETO_THRESHOLD=0.85

# ═══════════════════════════════════════════════════════════════
# HACP — Hyper-Accelerated Cognition Protocol (debate engine)
# ═══════════════════════════════════════════════════════════════
HACP_PARALLEL_THINKING_TIMEOUT_MS=15000
HACP_MAX_DEBATE_ROUNDS=3
HACP_CONSENSUS_THRESHOLD=0.60
HACP_TOTAL_TIMEOUT_MS=120000
HACP_STAGGER_DELAY_MS=4000

# ═══════════════════════════════════════════════════════════════
# SIGMOID·GA — Genetic algorithm for sentiment analysis
# ═══════════════════════════════════════════════════════════════
GA_POPULATION_SIZE=20
GA_MUTATION_RATE=0.15
GA_CROSSOVER_RATE=0.70

# ═══════════════════════════════════════════════════════════════
# MASSIVE.COM — Options Data Layer (v2.0.58)
# Required for Stocks/RWA trading — provides IV Rank, Greeks, P/C ratio
# Get your API key at https://massive.com
# ═══════════════════════════════════════════════════════════════
MASSIVE_API_KEY=

# ═══════════════════════════════════════════════════════════════
# EXP — Thesis Experience Vector Memory (v2.0.138)
# ═══════════════════════════════════════════════════════════════
EXP_ENABLED=false
EXP_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
EXP_EMBED_DIM=384
EXP_MAX_RECORDS=1000
EXP_MATCH_THRESHOLD=0.55
EXP_WIN_PROB_THRESHOLD=0.6
EXP_LOSS_PROB_THRESHOLD=0.4
EXP_DELTA_THRESHOLD=0.55
EXP_MIN_DELTA_SAMPLES=2
EXP_DELTA_WIN_RATE_THRESHOLD=0.6
EXP_DELTA_LOSS_RATE_THRESHOLD=0.4
EXP_ALLOW_REVERSE=true
EXP_BREAKEVEN_IS=exclude
EXP_SIMILARITY_MODE=asymmetric

# ═══════════════════════════════════════════════════════════════
# EXP DIGEST — A2A Experience Digestion (v2.0.140)
# 三層經驗消化: LLM lesson digestion → embedding → classification
# ═══════════════════════════════════════════════════════════════
EXP_DIGEST_ENABLED=true
EXP_DIGEST_CLASSIFY_THRESHOLD=0.72
EXP_DIGEST_CLUSTER_THRESHOLD=0.80
EXP_DIGEST_MIN_CLASS_SIZE=2
EXP_DIGEST_CLASS_WIN_THRESHOLD=0.6
EXP_DIGEST_CLASS_LOSS_THRESHOLD=0.4
EXP_DIGEST_MAX_CACHE=300

# ═══════════════════════════════════════════════════════════════
# SYSTEM — Logging, timing, ports
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=info           # error | warn | info | debug
NODE_ENV=development      # development | production | test
HEARTBEAT_INTERVAL_MS=30000
DECISION_INTERVAL_MS=300000   # 5 min between decision cycles
API_PORT=3456

# ═══════════════════════════════════════════════════════════════
# ANALYSIS MODE + SUPABASE — v2.0.822+ (mats_app signal backend)
# ═══════════════════════════════════════════════════════════════
# 'true'  = signal-only (write DB, NO orders) — for mats_app client execution
# 'dual'  = signal + execution (write DB AND place orders) — PRODUCTION DEFAULT
# 'false' = execution-only (place orders, NO DB write) — legacy standalone mode
# Dual mode ensures the backend's own trades produce real thesis + trade
# records for the learning pipeline (OLR/EXP/AttnRes/Combo-WR), while the
# DB matrix is also written for the client. Without execution, the backend's
# learning systems get ZERO new trade outcomes to learn from.
ANALYSIS_MODE=dual

# Supabase project (mats_app). The service_role key bypasses RLS — keep secret.
# Missing → analysis writer disabled (local-only mode, logs analyses to console).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ═══════════════════════════════════════════════════════════════
# Q-RL DIRECTION SIGNAL (v2.0.861, Phase 1.1/1.2/1.5)
# ═══════════════════════════════════════════════════════════════
# 1.1 — inject Q-RL expectancy block into Meta-Agent context
QRL_DIRECTION_LEAN_ENABLED=true
# 1.2 — Q-RL expectancy conviction multiplier in the gate
QRL_EXPECTANCY_GATE=true
# 1.2 — minimum visits on the action's cell before dampening may fire
QRL_MIN_SAMPLES=20
# 1.2 — Q below this (fraction) counts as negative expectancy
QRL_NEG_THRESHOLD=-0.002
# 1.2 — dampen multiplier for robust negative expectancy (floor 0.3, never hard-block)
QRL_DAMPEN_FACTOR=0.5
# 1.2 — asymmetric positive boost (1.0 = off; only fires with median>0 AND t>=2)
QRL_BOOST_FACTOR=1.0
# 1.5 — minimum |buyQ-sellQ| spread (fraction) for a directional lean
QRL_DIRECTION_MIN_SPREAD=0.001

# ═══════════════════════════════════════════════════════════════
# SHADOW POOL PRIORITY EVICTION (v2.0.861)
# ═══════════════════════════════════════════════════════════════
# Blind shadows (0.1× cold-start priors) monopolise the 60-slot pool and
# starve the true-statistical A/B arms (statistical/qrl) + aligned arm
# (Q-RL's only live feed). When a higher-value shadow needs room, evict the
# OLDEST open blind that has NOT touched its SL/TP barrier.
SHADOW_EVICT_BLIND=true
# Max blinds evicted per open attempt (clamped [1,5]; 1 = one frees one slot)
SHADOW_EVICT_MAX_PER_CALL=1

# ═══════════════════════════════════════════════════════════════
# PAEL EXIT-PRICE LOCK (v2.0.862, Phase C)
# ═══════════════════════════════════════════════════════════════
# TP-side one-vote exit: when a position's MFE reaches the asset's typical
# favourable zone (PAEL p75×0.8; trending regime → p90), lock profit by
# closing deterministically. SL is NEVER touched (keeps noise room).
EXIT_PRICE_CLOSE_ENABLED=true
# Minimum hold (minutes) before the lock gate may fire (5-min MFE spike = noise)
EXIT_PRICE_LOCK_MIN_HOLD_MIN=15

# ═══════════════════════════════════════════════════════════════
# LLM WORLD-MODEL (v2.0.863) — 讀圖 + 數據可靠性
# ═══════════════════════════════════════════════════════════════
KLINE_BLOCK_ENABLED=true          # K-LINE STRUCTURE block 注入
DATA_QUALITY_BLOCK_ENABLED=true  # DATA QUALITY 標記注入
CHART_AWARE_CONVICTION=true       # K-LINE 趨勢 vs LLM 方向硬性校準(真駁通)
LLM_CONVICTION_CALIBRATION=true   # 規限①:LLM conviction 歷史 bin 校準(防 overconfident)
LLM_DIRECTION_VERIFIER=true     # v2.0.864:LLM 方向預測 + 平倉結果雙層校準(每 cycle 判斷 vs 實際價格 + 平倉賺蝕)
EV_FILTER=true                  # v2.0.865:期望值過濾器——負 EV(手續費都搵唔返)軟性降權
CLOSE_DECISION_CALIBRATION=true # v2.0.866:平倉判斷校準器(Phase A——記錄+驗證+統計,唔影響操作)
PLAN_G_HYBRID_DECAY=true        # v2.0.870-P16:混合衰減(打破 penalty death spiral)——cycle+win 20% / time 40%(floor,τ=24h) / edge 40%(極強 hard bypass);false → 舊 idle-only 衰減
PLAN_G_DECAY_TAU_HOURS=12       # v2.0.870-P16+P17:時間衰減基準 τ(主神裁決 12h——runs test 調製後實效 9–18h:連蝕成串×1.5/隨機×1.0/交替×0.75)
PLAN_G_EDGE_BYPASS_WILSON=0.70  # v2.0.870-P16:hard bypass wilsonLB 門檻(≥0.70 且 n∈[25,5000] 且 median/EWMA>0 且新鮮 → 強 edge 完全豁免 penalty)
PLAN_G_EDGE_BYPASS_SAMPLES=25   # v2.0.870-P16:hard bypass 最少樣本
PLAN_G_EDGE_MIN_SAMPLES=15      # v2.0.870-P16:graduated edge 通道最少樣本(低於 → 貢獻 0,冷啟動保守)
PLAN_G_EDGE_STALE_CYCLES=1000   # v2.0.870-P16-attack2:bypass 新鮮度窗口(combo 最後更新距而家超過此數 → 唔豁免;≈2× EWMA 半衰期)

# v2.0.870-P21: 8·18 SKHX 驗屍三連修
# P21-A: mean_reverting regime 下 FP drift 歸零(GBM drift 對 MR 係模型錯用)
FP_MR_ZERO_DRIFT=true
# P21-B: SL 距離地板 = 2× 實測止蝕滑點(P21-C 記錄);cap 防荒謬闊止蝕
STOP_SLIP_FLOOR_ENABLED=true
STOP_SLIP_FLOOR_MULT=2.0
STOP_SLIP_FLOOR_CAP_PCT=0.04


# v2.0.870-P22: Close-Calibrator 觀測(無 env,永遠 on;/api/close-calibration)
# v2.0.870-P22-G: MAE/MFE Historical Healer
# MAE_MFE_HEAL_ENABLED=true      # 預設 true;candle 權威重算歷史 min/maxValueReached
# MAE_MFE_HEAL_BATCH=8           # 每 cycle 處理幾多筆(預設 8;最大 100)
